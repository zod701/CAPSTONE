.venv
.env
.claude/
server.ps1

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 공간 파일 (분석 스크립트로 다시 만든다). 저장소에 둘 것은 아래 data/processed 의 예외(!)로 되살린다
*.geojson
*.gpkg
*.gpkg-shm
*.gpkg-wal

# 원본 데이터 (공공데이터포털에서 받는다 — data/README.md 출처표)
data/csv/

# 재생성 가능한 데이터 (스크립트로 다시 만든다)
data/external/
# 서버가 읽는 정제 결과만 저장소에 둔다 — Vercel 은 git 에서 빌드하므로 원본(csv)으로 다시 만들 수 없다
data/processed/*
!data/processed/bus_stops.csv
!data/processed/bus_route_stops.csv
!data/processed/subway_stations.csv
!data/processed/subway_line_seq.csv
!data/processed/subway_live_stations.csv
!data/processed/headway_bus.csv
!data/processed/headway_rail.csv
!data/processed/admin_sgg_web.geojson
# 공간 분석 격자(analysis/grid_cbd.py)에 필요하다 — 다시 만들려면 경계 원천 · GTFS 원본(data/csv)이 있어야 한다
!data/processed/admin_sgg.geojson
!data/processed/rail_runs.csv
!data/processed/rail_express.csv

# 런타임 상태 (쿼터 카운트)
web/backend/var/

# 앵커 탐색 산출물 (CLI 로 다시 만든다)
algo/out/

# 공간 분석 실행 꾸러미 — 저장소의 코드 · 데이터를 복사해 모은 것(analysis_kit/README.md)
analysis_kit/

# 기타 파일
explain_mat/
tmp/